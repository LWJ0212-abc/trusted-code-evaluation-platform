        "schema_version": {
          "const": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "非负bigint以字符串传输，避免客户端精度损失"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assignment_id": {
              "type": "string",
              "format": "uuid"
            },
            "submission_id": {
              "type": "string",
              "format": "uuid"
            },
            "grade_input_revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "description": "非负bigint以字符串传输，避免客户端精度损失"
            },
            "batch_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "assignment_id",
            "submission_id",
            "grade_input_revision",
            "batch_id"
          ]
        }
      },
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "aggregate_id",
        "aggregate_revision",
        "trace_id",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "grade.published"
        },
        "schema_version": {
          "const": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "非负bigint以字符串传输，避免客户端精度损失"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assignment_id": {
              "type": "string",
              "format": "uuid"
            },
            "publication_id": {
              "type": "string",
              "format": "uuid"
            },
            "publication_seq": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "description": "非负bigint以字符串传输，避免客户端精度损失"
            },
            "previous_publication_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshot_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "assignment_id",
            "publication_id",
            "publication_seq",
            "previous_publication_id",
            "snapshot_digest"
          ]
        }
      },
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "aggregate_id",
        "aggregate_revision",
        "trace_id",
        "payload"
      ]
    },
