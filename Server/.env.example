# Matching local tags are used first because compose.yaml uses pull_policy: missing.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.0
MYSQL_IMAGE=mysql:8.4

# Development-only placeholders. Copy this file to .env and replace every password.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-admin-password
KEYCLOAK_DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
