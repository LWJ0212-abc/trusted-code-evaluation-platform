# Matching local tags are used first because compose.yaml uses pull_policy: missing.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.0
MYSQL_IMAGE=mysql:8.4
RUSTFS_IMAGE=rustfs/rustfs:latest
KEYCLOAK_DB_PORT=3308

# Development-only placeholders. Copy this file to .env and replace every password.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-admin-password
KEYCLOAK_DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Dedicated business database. This is separate from Keycloak's database.
TCEP_DB_NAME=code_platform
TCEP_DB_USERNAME=coder
TCEP_DB_PASSWORD=replace-with-a-local-business-database-password
TCEP_DB_ROOT_PASSWORD=replace-with-a-local-business-root-password
TCEP_BUSINESS_DB_PORT=3309
TCEP_DB_PORT=3309

# Development-only RustFS S3-compatible object storage.
RUSTFS_ACCESS_KEY=replace-with-a-local-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-a-local-rustfs-secret-key
RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
